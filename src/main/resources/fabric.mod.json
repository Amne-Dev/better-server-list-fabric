{
	"schemaVersion": 1,
	"id": "better-server-list",
	"version": "${version}",
	"name": "Better Server List",
	"description": "Adds favorites and categories to the multiplayer server list.",
	"authors": [
		"AmDev"
	],
	"contributors": [
		"StarsShine11904"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/better-server-list",
		"sources": "https://github.com/Amne-Dev/better-server-list-fabric",
		"issues": "https://github.com/Amne-Dev/better-server-list-fabric/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/better-server-list/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"amdev.bsl.BetterServerList"
		],
		"fabric-datagen": [
			"amdev.bsl.BetterServerListDataGenerator"
		]
	},
	"mixins": [
		"better-server-list.mixins.json"
	],
	"depends": {
		"fabricloader": "${fabric_loader_dependency}",
		"minecraft": "${minecraft_dependency}",
		"java": ">=${java_min_version}"
	},
	"suggests": {
		"fabric-api": "*"
	}
}

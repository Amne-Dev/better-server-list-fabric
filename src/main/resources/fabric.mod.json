{
	"schemaVersion": 1,
	"id": "better-server-list",
	"version": "${version}",
	"name": "Better Server List",
	"description": "Adds favorites and categories to the multiplayer server list.",
	"authors": [
		"AmDev"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/better-server-list/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"amdev.bsl.BetterServerList"
		],
		"fabric-datagen": [
			"amdev.bsl.BetterServerListDataGenerator"
		]
	},
	"mixins": [
		"better-server-list.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}
